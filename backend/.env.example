# Backend environment template (safe to commit)
# Copy to backend/.env and fill with real values.

# AI providers
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Sports data provider
API_FOOTBALL_KEY=your_api_football_key

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id

# Telegram alerts (preferred). When BOTH are set, alerts go to Telegram instead of WhatsApp.
# Bot token from @BotFather (secret — never commit or share it).
TELEGRAM_BOT_TOKEN=
# Your chat ID with the bot (send the bot a message, then read it from getUpdates).
TELEGRAM_CHAT_ID=

# Alert safety cap (applies to Telegram and WhatsApp; in-memory, resets on restart)
# Max alerts per rolling 24 hours.
ALERT_MAX_PER_DAY=30
# Skip a message identical to one sent within this many minutes (0 = off).
ALERT_DEDUP_MINUTES=60

# Twilio WhatsApp (optional fallback, used only when the Telegram vars above are not both set)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_PHONE_NUMBER=whatsapp:+1234567890

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Alerts
MIN_CONFIDENCE_ALERT=65
# Base live poll interval (seconds). Keep conservative by default for quota safety.
LIVE_POLL_INTERVAL=30
# Optional fast mode while live matches exist; disabled unless ENABLE_ADAPTIVE_LIVE_POLL=true
ENABLE_ADAPTIVE_LIVE_POLL=false
LIVE_POLL_INTERVAL_WHEN_LIVE=12
# Quota heartbeat (ms). Set 0 to disable.
QUOTA_GUARD_HEARTBEAT_MS=15000
TRACKED_LEAGUES=1,2,3,4,10,39,78,135,140,1222

# V10.3 Daily Preparation (05:00 Europe/London)
DAILY_PREP_MAX_ANALYZED_FIXTURES=1250
DAILY_PREP_TEAM_CALL_BUDGET=2500
PORTAL_OPEN_REFRESH_COOLDOWN_MS=15000
# While at least one portal is connected, fetch the global live fixture list once per interval.
PORTAL_ACTIVE_LIVE_REFRESH_SECONDS=60
# Goal Fest: verified live stats only, bounded while portal is active.
GOAL_FEST_SCAN_SECONDS=300
GOAL_FEST_SCAN_LIMIT=16
GOAL_FEST_ALERT_THRESHOLD=70
# Extra historical evidence for deliberate match-click notes, not a poller.
# 12-hour shared cache; hard ceiling of 27 new calls/click and 160 extra calls/day.
# Set 0 to disable new historical-context calls. Core analysis still works.
ANALYST_CONTEXT_DAILY_CALL_LIMIT=160
ALLOW_ON_DEMAND_API_ENRICHMENT=true
ALLOW_MANUAL_DAILY_PREP=false
LIVE_INTELLIGENCE_INTERVAL_HOURS=2
DAILY_PREP_WHATSAPP_ALERT_LIMIT=8

# V10.6A: included API-Football prematch odds; shared quota guard/pacing apply.
ENABLE_PREMATCH_ODDS=true
ODDS_DAILY_CALL_BUDGET=120
# Optional: restrict to one API-Football bookmaker ID. Blank selects a returned bookmaker.
ODDS_BOOKMAKER_ID=

# Security
# Long random secret (e.g. `openssl rand -hex 32`). Admin/debug routes are disabled until set;
# portal write routes (log bet, played bets, "Check results") require it once set.
# Enter the same value once in the portal when it asks for the admin token.
ADMIN_TOKEN=
# Optional comma-separated CORS allowlist. `*` matches one host label or a port.
# Default: https://sporty-rabbi.netlify.app,https://*--sporty-rabbi.netlify.app,http://localhost:*,http://127.0.0.1:*
ALLOWED_ORIGINS=
